# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files to keep LF line endings in the repository
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.Modelfile text eol=lf
.env* text eol=lf

# Denote files that are binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
